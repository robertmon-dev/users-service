API_VERSION=v1
API_PORT=:8000
ENVIRONMENT=development
LOG_LEVEL=debug
TEST_MODE=

ENCRYPTION_SECRET_KEY=a-32-byte-long-local-secret-key!
JWT_PRIVATE_KEY_PATH=private_key.pem
JWT_PUBLIC_KEY_PATH=public_key.pem
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
HASHING_PEPPER=a-local-hashing-pepper
TOKEN_DURATION=15m

DB_USER=users_service
DB_PASSWORD=users_service_password
DB_HOST=localhost
DB_PORT=5434
DB_NAME=users_db
DB_SSL_CA_PATH=docker/certs/ca.crt
DB_SSL_CERT_PATH=docker/certs/client.crt
DB_SSL_KEY_PATH=docker/certs/client.key

REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
REDIS_SSL_CA_PATH=
REDIS_SSL_CERT_PATH=
REDIS_SSL_KEY_PATH=

KAFKA_BOOTSTRAP_SERVERS=localhost:9093,localhost:9095,localhost:9097
KAFKA_CLIENT_ID=users-service
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_PATH=
KAFKA_SSL_CERT_PATH=
KAFKA_SSL_KEY_PATH=
KAFKA_CLIENT_KEY_PASSWORD=
KAFKA_TOPICS=
KAFKA_BROKER_ID=0
KAFKA_NOTIFIER_TOPIC=notifications

DOCKER_SOCKET=
