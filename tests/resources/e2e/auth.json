{
  "test_cases": [
    {
      "name": "Register, activate account, and login succeeds",
      "description": "Full happy-path auth lifecycle: register -> read activation code from DB -> activate -> login and receive a bearer token",
      "steps": [
        {
          "type": "httpRequest",
          "description": "Register a new user",
          "params": {
            "method": "POST",
            "path": "/api/v1/auth/register",
            "body": {
              "name": "Jane Doe",
              "mail": "jane.doe@example.com",
              "password": "StrongPassword123!",
              "device_token": "device-1",
              "ip_address": "127.0.0.1",
              "user_agent": "e2e-test-agent",
              "os_name": "linux",
              "os_version": "1.0",
              "browser_name": "e2e-browser",
              "browser_version": "1.0"
            }
          },
          "expected": {
            "statusCode": 200
          }
        },
        {
          "type": "executeFunction",
          "description": "Fetch the activation code that was generated for the new user",
          "params": {
            "function_name": "tests.GetActivationCodeByMail",
            "args": [
              "jane.doe@example.com"
            ]
          },
          "store_result_as": "activationCode"
        },
        {
          "type": "httpRequest",
          "description": "Activate the account using the fetched code",
          "params": {
            "method": "PATCH",
            "path": "/api/v1/auth/activation/account",
            "body": {
              "code": "{{activationCode}}",
              "device_token": "device-1",
              "ip_address": "127.0.0.1",
              "user_agent": "e2e-test-agent",
              "os_name": "linux",
              "os_version": "1.0",
              "browser_name": "e2e-browser",
              "browser_version": "1.0"
            }
          },
          "expected": {
            "statusCode": 200
          }
        },
        {
          "type": "httpRequest",
          "description": "Log in with the activated account",
          "params": {
            "method": "POST",
            "path": "/api/v1/auth/login",
            "body": {
              "mail": "jane.doe@example.com",
              "password": "StrongPassword123!",
              "device_token": "device-1",
              "ip_address": "127.0.0.1",
              "user_agent": "e2e-test-agent",
              "os_name": "linux",
              "os_version": "1.0",
              "browser_name": "e2e-browser",
              "browser_version": "1.0"
            }
          },
          "expected": {
            "statusCode": 200
          },
          "store_result_as": "loginResult"
        },
        {
          "type": "assert",
          "description": "Login response must include a non-empty bearer token",
          "params": {
            "actual": "{{loginResult.data.token}}",
            "operator": "isNotEmpty",
            "message": "Expected login to return a bearer token"
          }
        },
        {
          "type": "assert",
          "description": "Login response must echo the user's mail",
          "params": {
            "actual": "{{loginResult.data.mail}}",
            "expected": "jane.doe@example.com",
            "operator": "equals",
            "message": "Expected login response mail to match the registered mail"
          }
        }
      ]
    },
    {
      "name": "Register fails when mail is already registered",
      "description": "Registering twice with the same mail must reject the second attempt",
      "steps": [
        {
          "type": "httpRequest",
          "description": "Register a user for the first time",
          "params": {
            "method": "POST",
            "path": "/api/v1/auth/register",
            "body": {
              "name": "Duplicate User",
              "mail": "duplicate.user@example.com",
              "password": "StrongPassword123!",
              "device_token": "device-1",
              "ip_address": "127.0.0.1",
              "user_agent": "e2e-test-agent",
              "os_name": "linux",
              "os_version": "1.0",
              "browser_name": "e2e-browser",
              "browser_version": "1.0"
            }
          },
          "expected": {
            "statusCode": 200
          }
        },
        {
          "type": "httpRequest",
          "description": "Attempt to register again with the same mail",
          "params": {
            "method": "POST",
            "path": "/api/v1/auth/register",
            "body": {
              "name": "Duplicate User",
              "mail": "duplicate.user@example.com",
              "password": "StrongPassword123!",
              "device_token": "device-2",
              "ip_address": "127.0.0.1",
              "user_agent": "e2e-test-agent",
              "os_name": "linux",
              "os_version": "1.0",
              "browser_name": "e2e-browser",
              "browser_version": "1.0"
            }
          },
          "expected": {
            "statusCode": 422
          }
        }
      ]
    },
    {
      "name": "Login fails with wrong password",
      "description": "An activated user must not be able to log in with an incorrect password",
      "steps": [
        {
          "type": "httpRequest",
          "description": "Register a new user",
          "params": {
            "method": "POST",
            "path": "/api/v1/auth/register",
            "body": {
              "name": "Wrong Password User",
              "mail": "wrong.password@example.com",
              "password": "StrongPassword123!",
              "device_token": "device-1",
              "ip_address": "127.0.0.1",
              "user_agent": "e2e-test-agent",
              "os_name": "linux",
              "os_version": "1.0",
              "browser_name": "e2e-browser",
              "browser_version": "1.0"
            }
          },
          "expected": {
            "statusCode": 200
          }
        },
        {
          "type": "executeFunction",
          "description": "Fetch the activation code that was generated for the new user",
          "params": {
            "function_name": "tests.GetActivationCodeByMail",
            "args": [
              "wrong.password@example.com"
            ]
          },
          "store_result_as": "activationCode"
        },
        {
          "type": "httpRequest",
          "description": "Activate the account",
          "params": {
            "method": "PATCH",
            "path": "/api/v1/auth/activation/account",
            "body": {
              "code": "{{activationCode}}",
              "device_token": "device-1",
              "ip_address": "127.0.0.1",
              "user_agent": "e2e-test-agent",
              "os_name": "linux",
              "os_version": "1.0",
              "browser_name": "e2e-browser",
              "browser_version": "1.0"
            }
          },
          "expected": {
            "statusCode": 200
          }
        },
        {
          "type": "httpRequest",
          "description": "Attempt to log in with the wrong password",
          "params": {
            "method": "POST",
            "path": "/api/v1/auth/login",
            "body": {
              "mail": "wrong.password@example.com",
              "password": "ThisIsNotTheRightPassword1!",
              "device_token": "device-1",
              "ip_address": "127.0.0.1",
              "user_agent": "e2e-test-agent",
              "os_name": "linux",
              "os_version": "1.0",
              "browser_name": "e2e-browser",
              "browser_version": "1.0"
            }
          },
          "expected": {
            "statusCode": 422
          }
        }
      ]
    },
    {
      "name": "Login fails for an unregistered mail",
      "description": "Logging in with a mail that was never registered must be rejected",
      "steps": [
        {
          "type": "httpRequest",
          "description": "Attempt to log in with an unknown mail",
          "params": {
            "method": "POST",
            "path": "/api/v1/auth/login",
            "body": {
              "mail": "nobody.here@example.com",
              "password": "StrongPassword123!",
              "device_token": "device-1",
              "ip_address": "127.0.0.1",
              "user_agent": "e2e-test-agent",
              "os_name": "linux",
              "os_version": "1.0",
              "browser_name": "e2e-browser",
              "browser_version": "1.0"
            }
          },
          "expected": {
            "statusCode": 422
          }
        }
      ]
    }
  ]
}
